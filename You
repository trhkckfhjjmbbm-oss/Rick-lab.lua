---------------------------------------------------------------- построение лаборатории
local function buildLab(origin)
	local model = Instance.new("Model")
	model.Name = "RickLab"

	local L = {
		model = model,
		neon = {},
		pulses = {},
		lights = {},
		guis = {},
		texts = {},
		rick = {},
		dipUntil = 0,
		phoenixT = -100,
		rickFade = false,
		textT = 0,
	}
	local count = 0

	local CYL = Enum.PartType.Cylinder
	local BALL = Enum.PartType.Ball
	local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- цилиндр стоймя
	local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- цилиндр вдоль Z

	local function P(name, size, cf, color, material, o)
		o = o or {}
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = origin * cf
		p.Color = color
		p.Material = material or Enum.Material.Metal
		p.Anchored = true
		p.Massless = true
		p.CanCollide = o.collide == true
		p.CanQuery = o.collide == true
		p.CanTouch = false
		p.CastShadow = false
		p.Transparency = o.t or 0
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if o.shape then
			p.Shape = o.shape
		end
		p.Parent = model
		count += 1
		return p
	end

	local function withShape(o, shape)
		local r = { shape = shape }
		if o then
			for k, v in pairs(o) do
				r[k] = v
			end
		end
		return r
	end

	local function cylV(name, h, d, pos, color, mat, o)
		return P(name, V(h, d, d), CFrame.new(pos) * UPRIGHT, color, mat, withShape(o, CYL))
	end
	local function cylX(name, len, d, pos, color, mat, o)
		return P(name, V(len, d, d), CFrame.new(pos), color, mat, withShape(o, CYL))
	end
	local function cylZ(name, len, d, pos, color, mat, o)
		return P(name, V(len, d, d), CFrame.new(pos) * ALONG_Z, color, mat, withShape(o, CYL))
	end
	local function ball(name, d, pos, color, mat, o)
		return P(name, V(d, d, d), CFrame.new(pos), color, mat, withShape(o, BALL))
	end

	local function glow(p, color)
		L.neon[#L.neon + 1] = { part = p, color = color, baseT = p.Transparency }
	end

	local function addLight(parent, color, range, brightness)
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = range
		l.Brightness = brightness
		l.Shadows = false
		l.Parent = parent
		L.lights[#L.lights + 1] = l
		return l
	end

	-- коробка комнаты 20x20x12 (внутри), стены толщиной 1
	local floor = P("Floor", V(22, 1, 22), CFrame.new(0, -0.5, 0), DARK2, Enum.Material.DiamondPlate, { collide = true })
	P("Ceiling", V(22, 1, 22), CFrame.new(0, 12.5, 0), DARK2, Enum.Material.Metal, { collide = true })
	P("WallN", V(22, 12, 1), CFrame.new(0, 6, -10.5), DARK, Enum.Material.Metal, { collide = true })
	P("WallS", V(22, 12, 1), CFrame.new(0, 6, 10.5), DARK, Enum.Material.Metal, { collide = true })
	P("WallE", V(1, 12, 20), CFrame.new(10.5, 6, 0), DARK, Enum.Material.Metal, { collide = true })
	P("WallW", V(1, 12, 20), CFrame.new(-10.5, 6, 0), DARK, Enum.Material.Metal, { collide = true })

	-- неоновые панели: по 3 каждого цвета (Part + Neon + PointLight)
	local panelSpecs = {
		{ "N", 9.6, -4, 6, 1 }, { "N", 9.6, 4, 6, 2 }, { "N", 7.2, 0, 10, 3 },
		{ "S", 9.6, -4, 6, 4 }, { "S", 9.6, 4, 6, 1 }, { "S", 7.2, 0, 10, 2 },
		{ "W", 9.6, -4, 6, 3 }, { "W", 9.6, 4, 6, 4 }, { "W", 7.2, 0, 10, 1 },
		{ "E", 10.4, -4, 6, 2 }, { "E", 10.4, 4, 6, 3 }, { "E", 9.0, 0, 10, 4 },
	}
	for i, s in ipairs(panelSpecs) do
		local wall, y, c, w, ci = s[1], s[2], s[3], s[4], s[5]
		local color = COLORS[ci]
		local size, cf
		if wall == "N" then
			size, cf = V(w, 0.5, 0.15), CFrame.new(c, y, -9.92)
		elseif wall == "S" then
			size, cf = V(w, 0.5, 0.15), CFrame.new(c, y, 9.92)
		elseif wall == "W" then
			size, cf = V(0.15, 0.5, w), CFrame.new(-9.92, y, c)
		else
			size, cf = V(0.15, 0.5, w), CFrame.new(9.92, y, c)
		end
		local p = P("Panel", size, cf, color, Enum.Material.Neon)
		glow(p, color)
		local l = addLight(p, color, 12, 1)
		L.pulses[#L.pulses + 1] = {
			light = l, min = 0.35, max = 1.7, speed = 1.1 + (i % 4) * 0.3, phase = i * 0.8,
			part = p, tmin = 0, tmax = 0.35,
		}
	end

	-- свет для пола: 4 источника (Attachment, без лишних деталей)
	local corners = { { -6, -6, 1 }, { 6, -6, 2 }, { 6, 6, 3 }, { -6, 6, 4 } }
	for i, c in ipairs(corners) do
		local att = Instance.new("Attachment")
		att.Position = V(c[1], 2.3, c[2]) -- 1.8 стада над полом
		att.Parent = floor
		local l = addLight(att, COLORS[c[3]], 16, 0.8)
		L.pulses[#L.pulses + 1] = { light = l, min = 0.25, max = 1.0, speed = 0.8 + i * 0.25, phase = i * 1.7 }
	end

	-- неоновые полосы на полу вокруг колбы
	local strips = {
		{ V(10, 0.05, 0.2), V(0, 0.03, -5), 1 }, { V(10, 0.05, 0.2), V(0, 0.03, 5), 3 },
		{ V(0.2, 0.05, 10), V(-5, 0.03, 0), 2 }, { V(0.2, 0.05, 10), V(5, 0.03, 0), 4 },
	}
	for _, s in ipairs(strips) do
		local p = P("FloorStrip", s[1], CFrame.new(s[2]), COLORS[s[3]], Enum.Material.Neon)
		glow(p, COLORS[s[3]])
	end

	-- колба: постамент, стекло, жидкость, крышки, труба
	cylV("PedestalBase", 0.8, 3.4, V(0, 0.4, 0), DARK2, Enum.Material.Metal, { collide = true })
	cylV("PedestalCollar", 0.3, 2.4, V(0, 0.95, 0), STEEL, Enum.Material.Metal, { collide = true })

	local glass = cylV("CapsuleGlass", 6, 2, V(0, 4.0, 0), Color3.fromRGB(170, 255, 230), Enum.Material.Glass, { t = 0.6 })
	glass.Reflectance = 0.1

	local inner = cylV("CapsuleLiquid", 5.8, 1.7, V(0, 4.0, 0), Color3.fromRGB(70, 255, 140), Enum.Material.Neon, { t = 0.3 })
	glow(inner, Color3.fromRGB(70, 255, 140))
	L.inner = inner
	L.capLight = addLight(inner, Color3.fromRGB(80, 255, 140), 20, 2.2)

	cylV("CapsuleCap", 0.5, 2.5, V(0, 7.25, 0), STEEL, Enum.Material.Metal)
	cylV("CapsulePipe", 4.5, 0.5, V(0, 9.75, 0), GRAY, Enum.Material.Metal)

	-- пузырьки внутри колбы
	local emitterPart = P("BubbleEmitter", V(1.4, 0.2, 1.4), CFrame.new(0, 1.2, 0), Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic, { t = 1 })
	local em = Instance.new("ParticleEmitter")
	em.Rate = 18
	em.Lifetime = NumberRange.new(2.2, 3.0)
	em.Speed = NumberRange.new(2, 2.8)
	em.SpreadAngle = Vector2.new(6, 6)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.3) })
	em.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.8, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	em.Color = ColorSequence.new(Color3.fromRGB(190, 255, 220))
	em.LightEmission = 0.7
	em.Parent = emitterPart

	local burst = Instance.new("ParticleEmitter")
	burst.Enabled = false
	burst.Rate = 0
	burst.Lifetime = NumberRange.new(0.8, 1.4)
	burst.Speed = NumberRange.new(8, 14)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Size = NumberSequence.new(0.35, 0)
	burst.LightEmission = 1
	burst.Color = ColorSequence.new(Color3.fromRGB(80, 255, 140))
	burst.Parent = emitterPart
	L.burst = burst

	-- кнопки на постаменте
	local btnColors = { COLORS[1], COLORS[2], COLORS[3], COLORS[4], Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 220, 60) }
	for i, c in ipairs(btnColors) do
		local a = math.rad(30 + (i - 1) * 60)
		local b = cylV("PedestalButton", 0.12, 0.28, V(math.cos(a) * 1.5, 0.86, math.sin(a) * 1.5), c, Enum.Material.Neon)
		glow(b, c)
	end

	-- силуэт внутри колбы (упрощённый: голова-шар, тело-блок, руки-цилиндры, шипы-волосы)
	local function rickPart(name, size, cf, shape)
		local p = P(name, size, cf, SIL, Enum.Material.SmoothPlastic, { t = 0.35, shape = shape })
		L.rick[#L.rick + 1] = p
		return p
	end
	rickPart("SilHead", V(0.75, 0.75, 0.75), CFrame.new(0, 5.5, 0), BALL)
	rickPart("SilBody", V(0.8, 1.4, 0.45), CFrame.new(0, 4.4, 0))
	local ax, ay = math.cos(math.rad(35)) * 0.55, math.sin(math.rad(35)) * 0.55
	rickPart("SilArmR", V(1.1, 0.2, 0.2), CFrame.new(0.5 + ax, 4.95 + ay, 0) * CFrame.Angles(0, 0, math.rad(35)), CYL)
	rickPart("SilArmL", V(1.1, 0.2, 0.2), CFrame.new(-0.5 - ax, 4.95 + ay, 0) * CFrame.Angles(0, 0, math.rad(145)), CYL)
	rickPart("SilLegR", V(0.28, 1.3, 0.28), CFrame.new(0.22, 3.1, 0) * CFrame.Angles(0, 0, math.rad(8)))
	rickPart("SilLegL", V(0.28, 1.3, 0.28), CFrame.new(-0.22, 3.1, 0) * CFrame.Angles(0, 0, math.rad(-8)))
	rickPart("SilHair", V(0.14, 0.55, 0.14), CFrame.new(-0.2, 6.0, 0) * CFrame.Angles(0, 0, math.rad(-20)))
	rickPart("SilHair", V(0.14, 0.55, 0.14), CFrame.new(0, 6.05, 0))
	rickPart("SilHair", V(0.14, 0.55, 0.14), CFrame.new(0.2, 6.0, 0) * CFrame.Angles(0, 0, math.rad(20)))

	-- столы
	local TS = 3.125 -- верхняя плоскость столов
	P("TableW", V(2.4, 0.25, 8), CFrame.new(-8.7, 3, 0), TABLE, Enum.Material.Metal, { collide = true })
	P("TableWLeg", V(2.2, 2.875, 0.25), CFrame.new(-8.7, 1.4375, -3.8), TABLE, Enum.Material.Metal, { collide = true })
	P("TableWLeg", V(2.2, 2.875, 0.25), CFrame.new(-8.7, 1.4375, 3.8), TABLE, Enum.Material.Metal, { collide = true })

	P("TableN", V(10, 0.25, 2.4), CFrame.new(2, 3, -8.7), TABLE, Enum.Material.Metal, { collide = true })
	P("TableNLeg", V(0.25, 2.875, 2.2), CFrame.new(-2.8, 1.4375, -8.7), TABLE, Enum.Material.Metal, { collide = true })
	P("TableNLeg", V(0.25, 2.875, 2.2), CFrame.new(6.8, 1.4375, -8.7), TABLE, Enum.Material.Metal, { collide = true })

	P("TableS", V(8, 0.25, 2.4), CFrame.new(-2, 3, 8.7), TABLE, Enum.Material.Metal, { collide = true })
	P("TableSLeg", V(0.25, 2.875, 2.2), CFrame.new(-5.8, 1.4375, 8.7), TABLE, Enum.Material.Metal, { collide = true })
	P("TableSLeg", V(0.25, 2.875, 2.2), CFrame.new(1.8, 1.4375, 8.7), TABLE, Enum.Material.Metal, { collide = true })

	-- микроскоп (цилиндры + шары)
	local mx, mz = -8.7, -2.2
	P("MicroBase", V(0.9, 0.12, 0.9), CFrame.new(mx, TS + 0.06, mz), GRAY)
	cylV("MicroPillar", 1.3, 0.2, V(mx - 0.15, TS + 0.77, mz), STEEL, Enum.Material.Metal)
	P("MicroTube", V(1.0, 0.3, 0.3), CFrame.new(mx, TS + 1.5, mz) * CFrame.Angles(0, 0, math.rad(70)), DARK2,
		Enum.Material.Metal, { shape = CYL })
	ball("MicroEyepiece", 0.28, V(mx + 0.19, TS + 2.02, mz), STEEL, Enum.Material.Metal)
	ball("MicroLens", 0.2, V(mx - 0.19, TS + 0.98, mz), STEEL, Enum.Material.Metal)

	-- жёлтая светящаяся колба
	local flask = ball("FlaskBulb", 0.9, V(-8.7, TS + 0.45, 2.6), Color3.fromRGB(255, 220, 60), Enum.Material.Neon, { t = 0.25 })
	glow(flask, Color3.fromRGB(255, 220, 60))
	cylV("FlaskNeck", 0.6, 0.28, V(-8.7, TS + 1.1, 2.6), Color3.fromRGB(200, 230, 220), Enum.Material.Glass, { t = 0.4 })
	local fl = addLight(flask, Color3.fromRGB(255, 220, 60), 9, 1.2)
	L.pulses[#L.pulses + 1] = { light = fl, min = 0.8, max = 1.6, speed = 2.4, phase = 0 }

	-- банки
	cylV("Jar", 0.8, 0.55, V(-8.9, TS + 0.4, -0.3), Color3.fromRGB(80, 200, 190), Enum.Material.Glass, { t = 0.35 })
	cylV("Jar", 0.8, 0.55, V(-8.5, TS + 0.4, 0.4), Color3.fromRGB(230, 150, 60), Enum.Material.Glass, { t = 0.35 })
	cylV("Jar", 0.8, 0.55, V(-8.9, TS + 0.4, 1.0), Color3.fromRGB(140, 220, 70), Enum.Material.Glass, { t = 0.35 })
	cylV("Jar", 0.8, 0.55, V(-5.0, TS + 0.4, 8.7), Color3.fromRGB(200, 120, 255), Enum.Material.Glass, { t = 0.35 })
	cylV("Jar", 0.8, 0.55, V(-4.2, TS + 0.4, 8.7), Color3.fromRGB(255, 120, 150), Enum.Material.Glass, { t = 0.35 })

	-- прибор на южном столе (корпус, ствол, светящийся кончик)
	P("GadgetBody", V(0.35, 0.5, 0.9), CFrame.new(-1.5, TS + 0.25, 8.7), Color3.fromRGB(220, 225, 230), Enum.Material.SmoothPlastic)
	cylZ("GadgetBarrel", 0.6, 0.18, V(-1.5, TS + 0.35, 8.7 - 0.75), STEEL, Enum.Material.Metal)
	local tip = ball("GadgetTip", 0.22, V(-1.5, TS + 0.35, 8.7 - 1.1), COLORS[4], Enum.Material.Neon)
	glow(tip, COLORS[4])

	-- мониторы с зелёным текстом (Part + SurfaceGui)
	for i, x in ipairs({ -0.8, 2.0, 4.8 }) do
		P("MonitorStand", V(0.5, 0.35, 0.3), CFrame.new(x, TS + 0.175, -9.0), DARK2, Enum.Material.Metal)
		local mpos = V(x, TS + 1.0, -9.0)
		local m = P("Monitor", V(2.2, 1.3, 0.15), CFrame.lookAt(mpos, mpos + V(0, 0, 1)), Color3.fromRGB(10, 14, 12),
			Enum.Material.SmoothPlastic)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(440, 260)
		sg.LightInfluence = 0
		sg.Brightness = 1.5
		sg.Parent = m
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(4, 20, 10)
		bg.BorderSizePixel = 0
		bg.Parent = sg
		local tl = Instance.new("TextLabel")
		tl.Position = UDim2.fromOffset(12, 12)
		tl.Size = UDim2.new(1, -24, 1, -24)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.Code
		tl.TextSize = 30
		tl.TextColor3 = Color3.fromRGB(80, 255, 120)
		tl.TextXAlignment = Enum.TextXAlignment.Left
		tl.TextYAlignment = Enum.TextYAlignment.Top
		tl.Text = TEXTS[i]()
		tl.Parent = bg
		L.guis[#L.guis + 1] = sg
		L.texts[i] = tl
	end

	-- ящики
	local CRATE = Color3.fromRGB(80, 70, 55)
	P("Crate", V(1.2, 1.2, 1.2), CFrame.new(8.0, 0.6, 7.0), CRATE, Enum.Material.Metal, { collide = true })
	P("Crate", V(1.2, 1.2, 1.2), CFrame.new(8.2, 0.6, 8.4), CRATE, Enum.Material.Metal, { collide = true })
	P("Crate", V(1.2, 1.2, 1.2), CFrame.new(8.1, 1.8, 7.7), CRATE, Enum.Material.Metal, { collide = true })
	P("Crate", V(1.0, 1.0, 1.0), CFrame.new(8.5, 0.5, -8.5), CRATE, Enum.Material.Metal, { collide = true })

	-- трубы: потолок и стены
	for _, z in ipairs({ -6, 0, 6 }) do
		cylX("PipeX", 20, 0.55, V(0, 11.3, z), GRAY, Enum.Material.Metal)
	end
	for _, x in ipairs({ -6, 6 }) do
		cylZ("PipeZ", 20, 0.45, V(x, 10.6, 0), GRAY, Enum.Material.Metal)
	end
	for _, p in ipairs({ { 9.6, -9.6 }, { 9.6, 9.6 }, { -9.6, 9.6 } }) do
		cylV("PipeV", 11.8, 0.5, V(p[1], 6, p[2]), GRAY, Enum.Material.Metal)
	end
	cylX("PipeWallN", 19.6, 0.4, V(0, 10.9, -9.65), GRAY, Enum.Material.Metal)
	cylX("PipeWallS", 19.6, 0.4, V(0, 0.5, 9.65), GRAY, Enum.Material.Metal)

	-- лестница в углу (перила + ступеньки)
	P("LadderRail", V(0.18, 11.4, 0.18), CFrame.new(-9.7, 5.7, -9.1), STEEL)
	P("LadderRail", V(0.18, 11.4, 0.18), CFrame.new(-9.7, 5.7, -7.9), STEEL)
	for i = 0, 6 do
		P("LadderRung", V(0.15, 0.15, 1.2), CFrame.new(-9.7, 1 + i * 1.6, -8.5), STEEL)
	end

	-- круглый люк на потолке
	cylV("HatchDisc", 0.3, 2.2, V(-8.5, 11.8, -8.5), GRAY, Enum.Material.Metal)
	cylV("HatchRing", 0.2, 2.7, V(-8.5, 11.9, -8.5), STEEL, Enum.Material.Metal)
	P("HatchBar", V(1.5, 0.12, 0.12), CFrame.new(-8.5, 11.6, -8.5), STEEL)
	P("HatchBar", V(0.12, 0.12, 1.5), CFrame.new(-8.5, 11.6, -8.5), STEEL)

	-- гаражные ворота на восточной стене
	P("GarageDoor", V(0.3, 7.5, 9), CFrame.new(9.8, 3.75, 0), Color3.fromRGB(70, 76, 88), Enum.Material.Metal, { collide = true })
