---------------------------------------------------------------- эффекты
local function update()
	if not lab then
		return
	end
	local t = os.clock()

	if lightsOn then
		-- плавная пульсация панелей и света
		for _, e in ipairs(lab.pulses) do
			local s = (math.sin(t * e.speed + e.phase) + 1) * 0.5
			e.light.Brightness = e.min + (e.max - e.min) * s
			if e.part then
				e.part.Transparency = e.tmin + (e.tmax - e.tmin) * (1 - s)
			end
		end

		-- колба мигает зелёным
		local f = 1 + 0.5 * math.noise(t * 8, 3.3)
		if t < lab.dipUntil then
			f = 0.15
		elseif math.random() < 0.012 then
			lab.dipUntil = t + 0.08
		end
		local boost = math.max(0, 1 - (t - lab.phoenixT) / 2.5) * 6
		lab.capLight.Brightness = (2.2 + boost) * f
		lab.inner.Transparency = 0.25 + 0.3 * (1 - math.clamp(f, 0, 1))

		-- текст на мониторах
		if t - lab.textT > 1 then
			lab.textT = t
			for i, tl in ipairs(lab.texts) do
				tl.Text = TEXTS[i]()
			end
		end
	end

	-- силуэт исчезает и возвращается после «Феникса»
	local age = t - lab.phoenixT
	if age < 6 then
		local tr = (age < 4) and 1 or (1 - 0.65 * ((age - 4) / 2))
		for _, p in ipairs(lab.rick) do
			p.Transparency = tr
		end
	elseif lab.rickFade then
		lab.rickFade = false
		for _, p in ipairs(lab.rick) do
			p.Transparency = 0.35
		end
	end
end

local function setLights(on)
	lightsOn = on
	if not lab then
		return
	end
	for _, n in ipairs(lab.neon) do
		n.part.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
		n.part.Color = on and n.color or n.color:Lerp(Color3.new(0, 0, 0), 0.8)
		if not on then
			n.part.Transparency = n.baseT
		end
	end
	for _, l in ipairs(lab.lights) do
		l.Enabled = on
	end
	for _, sg in ipairs(lab.guis) do
		sg.Enabled = on
	end
end

local function removeLab()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if lab then
		lab.model:Destroy()
		lab = nil
	end
end

